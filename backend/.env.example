# Generate privately: python -c "import secrets; print(secrets.token_urlsafe(32))"
NARAD_API_ACCESS_KEY=replace-with-a-private-random-value-of-at-least-24-characters
NARAD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NARAD_CALIBRATION_PATH=backend/artifacts/policy_c.joblib
# After running the one-time benchmark, uncomment:
# NARAD_WORKER_PROFILE=backend/artifacts/workers.json
# Optional explicit override, bounded by runtime CPUs; leave unset to use profile.
# NARAD_CONTROLLER_MAX_CPU_WORKERS=8
# Optional default graph for legacy /api endpoints; /gui accepts custom graphs.
# NARAD_NETWORK_PATH=gui/examples/network.json
